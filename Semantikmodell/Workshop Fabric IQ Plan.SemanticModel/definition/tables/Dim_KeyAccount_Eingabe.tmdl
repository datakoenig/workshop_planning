	partition Dim_KeyAccount_Eingabe = m
		mode: import
		source =
				let
				    // Gleiche Quelle wie Dim_KeyAccount; eigene Tabelle, damit eine zweite RLS-Regel (Schreibrechte) darauf wirken kann
				    Quelle = Csv.Document(File.Contents(Ordner & "Dim_KeyAccount.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"KeyAccountID", type text}, {"KeyAccount", type text}, {"Region", type text}, {"Land", type text}}, "en-US")
				in
				    Typen

