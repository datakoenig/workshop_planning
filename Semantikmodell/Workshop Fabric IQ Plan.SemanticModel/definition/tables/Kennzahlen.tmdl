	measure 'Menge Ist/LE' =
			-- je Periode: abgeschlossen -> Ist, offen -> neuester Forecast-Stand; auch auf Quartals-/Jahresebene korrekt
			SUMX ( VALUES ( Dim_Kalender[Periode] ), IF ( CALCULATE ( MAX ( Dim_Kalender[Status] ) ) = "abgeschlossen", [Menge Ist], [Last Estimate Menge] ) )
		formatString: #,0
