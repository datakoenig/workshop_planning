	measure 'Umsatz Ist/LE' = SUMX ( VALUES ( Dim_Kalender[Periode] ), IF ( CALCULATE ( MAX ( Dim_Kalender[Status] ) ) = "abgeschlossen", [Umsatz Ist], [Last Estimate Umsatz] ) )
		formatString: #,0
