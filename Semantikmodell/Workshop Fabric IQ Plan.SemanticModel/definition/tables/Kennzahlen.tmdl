	measure 'GuV Betrag VJ' =
			VAR _vj = MAX ( Dim_Kalender[Jahr] ) - 1
			VAR _monate = VALUES ( Dim_Kalender[Monat] )
			RETURN CALCULATE ( [GuV Betrag Ist], REMOVEFILTERS ( Dim_Kalender ), Dim_Kalender[Jahr] = _vj, _monate )
		formatString: #,0.00
		lineageTag: 6cf1cf66-8174-4850-b6a5-dc927d21d57d

	measure 'GuV Abw. VJ' = [GuV Betrag Ist] - [GuV Betrag VJ]
		formatString: #,0.00;-#,0.00;0
		lineageTag: eae4e0b9-44ab-4796-8599-12fabeaaa613

	measure 'GuV Abw. VJ %' = DIVIDE ( [GuV Betrag Ist] - [GuV Betrag VJ], ABS ( [GuV Betrag VJ] ) )
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: dad81e5f-ed1d-40c4-a9a5-cdb6ed0510d0

	measure 'Var. Stückkosten Ist' = DIVIDE ( [Variable Kosten Ist], [Menge Ist] )
		formatString: #,0.00
		lineageTag: 9e2c1cb1-0615-47cf-83a0-c4cbedc15197

	measure Treiberwert =
			-- Wert je Member von Dim_Treiber für das Row Model (Treiberbaum) im Planning Sheet; Fixkosten nach Umsatzanteil zugerechnet
			SWITCH (
			    SELECTEDVALUE ( Dim_Treiber[Treiber] ),
			    "Absatzmenge", [Menge Ist],
			    "Preis", [Preis Ist],
			    "VarStueckkosten", [Var. Stückkosten Ist],
			    "Umsatz", [Umsatz Ist],
			    "VariableKosten", [Variable Kosten Ist],
			    "Deckungsbeitrag", [Deckungsbeitrag Ist],
			    "Fixkosten", [Gemeinkosten Ist (zugerechnet)] - [Sonstige Erträge Ist (zugerechnet)],
			    "EBIT", [EBIT Ist],
			    "Umsatzrendite", [Umsatzrendite Ist]
			)
		formatString: #,0.00
		lineageTag: 77dd325c-d824-4850-a9e1-b01dde136a40

	measure Kommentare =
			-- alle Kommentare im aktuellen Kontext (GuV-Zeile × Periode), chronologisch, für die Anzeige neben den Zahlen
			CONCATENATEX (
			    Fact_Kommentare,
			    Fact_Kommentare[Bearbeiter] & ": " & Fact_Kommentare[Kommentar],
			    UNICHAR ( 10 ),
			    Fact_Kommentare[Zeitstempel], ASC
			)
		lineageTag: 9f316b0f-2aad-46b5-86b1-9801f643d9e0

	measure 'Kommentar vorhanden' = IF ( [Anzahl Kommentare] > 0, "●", "" )
		lineageTag: 2f823349-5906-47d6-af9c-0316921b8762

	column Platzhalter
		dataType: string
		isHidden
		lineageTag: 210c2515-a4e6-43f6-b993-e8bbf821f0aa
		summarizeBy: none
		sourceColumn: [Platzhalter]

	partition Kennzahlen = calculated
		mode: import
		source = ROW ( "Platzhalter", BLANK () )

