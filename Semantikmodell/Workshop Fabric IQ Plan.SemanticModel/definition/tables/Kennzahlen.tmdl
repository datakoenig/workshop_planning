	measure Umsatzanteil =
			-- Anteil des gefilterten Umsatzes (Produkt / Key Account) am Gesamtumsatz, für die Schlüsselung der Gemeinkosten
			DIVIDE ( [Umsatz Ist], CALCULATE ( [Umsatz Ist], REMOVEFILTERS ( Dim_Produkt ), REMOVEFILTERS ( Dim_KeyAccount ) ) )
		formatString: 0.0 %
		lineageTag: 00f5cffd-0b36-4df6-8571-1a006b2f8f66

	measure 'Gemeinkosten Ist (zugerechnet)' = [Gemeinkosten Ist] * [Umsatzanteil]
		formatString: #,0
