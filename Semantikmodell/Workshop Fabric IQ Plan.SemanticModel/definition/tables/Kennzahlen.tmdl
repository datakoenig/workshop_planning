	measure 'Menge Ist VJ' =
			-- Vorjahreswert im gleichen Monat (bzw. Quartal/Jahr), unabhängig von Periode-Filtern
			VAR _vj = MAX ( Dim_Kalender[Jahr] ) - 1
			VAR _monate = VALUES ( Dim_Kalender[Monat] )
			RETURN CALCULATE ( [Menge Ist], REMOVEFILTERS ( Dim_Kalender ), Dim_Kalender[Jahr] = _vj, _monate )
		formatString: #,0
		lineageTag: a3c8ae43-9b71-4025-b465-f8a43211b102

	measure 'Umsatz Ist VJ' =
