		formatString: #,0
		lineageTag: 010a3ce0-281d-4816-ab30-3724180b3b38

	measure 'Last Estimate Umsatz' =
			-- Neuester Forecast-Stand, unabhängig von einer Stand-Auswahl
			VAR _neu = CALCULATE ( MAX ( Dim_ForecastStand[Sortierung] ), REMOVEFILTERS ( Dim_ForecastStand ) )
			RETURN CALCULATE ( [Forecast Umsatz], REMOVEFILTERS ( Dim_ForecastStand ), Dim_ForecastStand[Sortierung] = _neu )
		formatString: #,0
		lineageTag: e22cb2ff-99cb-4233-8363-5af2cacf959d

	measure 'Letzter Forecast für Periode' =
			-- Für abgeschlossene Perioden: der Stand, der im Monat der Periode erstellt wurde (Horizont 0)
			VAR _mo = MAX ( Dim_Kalender[Monat] )
			RETURN CALCULATE ( [Forecast Umsatz], REMOVEFILTERS ( Dim_ForecastStand ), Dim_ForecastStand[Sortierung] = _mo )
		formatString: #,0
		lineageTag: 440db903-95ba-427e-872f-6bd620db2bef

	measure 'LE / Ist Umsatz' = [Umsatz Ist/LE]
