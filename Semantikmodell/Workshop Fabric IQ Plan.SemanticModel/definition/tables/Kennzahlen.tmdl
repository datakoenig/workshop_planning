	measure Schreibrecht =
			-- 1, wenn im aktuellen Kontext mindestens ein Key Account liegt, für den der angemeldete Nutzer schreiben darf
			-- (robust für Zeilen, Summen und Spaltenkontexte); Text "Ja"/"Nein", weil Fabric Plan Measure-Filterwerte als Text übergibt; Filter im Eingabe-Sheet: Schreibrecht = Ja
			VAR _erlaubt =
			    SELECTCOLUMNS (
			        FILTER (
			            ALL ( Berechtigung_KeyAccount ),
			            Berechtigung_KeyAccount[Benutzer] = USERPRINCIPALNAME ()
			                && Berechtigung_KeyAccount[Planungsbereich] = "Vertrieb"
			                && Berechtigung_KeyAccount[Recht] = "Schreiben"
			        ),
			        "k", Berechtigung_KeyAccount[KeyAccountID]
			    )
			RETURN
			    IF ( COUNTROWS ( INTERSECT ( VALUES ( Dim_KeyAccount[KeyAccountID] ), _erlaubt ) ) > 0, "Ja", "Nein" )
		lineageTag: 84b02565-4b9e-4cfc-8440-73b30cff0d8d

	measure 'Angemeldeter Benutzer' = USERPRINCIPALNAME ()
		lineageTag: 1fb07dba-ee96-4305-abbf-7bc996c3f47e

	measure 'Budget Menge Land' =
			-- Landessumme unabhängig vom Key-Account-Filter (z.B. Schreibrecht = 1); innerhalb der RLS
			VAR _land = VALUES ( Dim_KeyAccount[Land] )
			RETURN CALCULATE ( [Budget Menge], REMOVEFILTERS ( Dim_KeyAccount ), TREATAS ( _land, Dim_KeyAccount[Land] ) )
		formatString: #,0
